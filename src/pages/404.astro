---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
  title="页面不存在"
  titleEn="Page not found"
  description="请求的 SagaSmithAI 页面不存在。"
  descriptionEn="The requested SagaSmithAI page does not exist."
  page="404"
  noindex={true}
>
  <section class="not-found shell">
    <div>
      <strong aria-hidden="true">404</strong>
      <h1><span class="zh">这条时间线没有这个页面。</span><span class="en">This timeline has no such page.</span></h1>
      <p><span class="zh">链接可能已经移动，或者地址输入有误。</span><span class="en">The link may have moved, or the address may be mistyped.</span></p>
      <div class="button-row" style="justify-content:center">
        <a class="button primary" href="/"><span class="zh">返回首页</span><span class="en">Return home</span></a>
        <a class="button" href="/developers#repositories"><span class="zh">当前仓库地图</span><span class="en">Current repository map</span></a>
      </div>
    </div>
  </section>
</SiteLayout>
