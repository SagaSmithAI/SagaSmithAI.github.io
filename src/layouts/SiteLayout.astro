---
import '../styles/site.css';

interface Props {
  title: string;
  titleEn: string;
  description: string;
  descriptionEn: string;
  page?: 'home' | 'start' | 'developers' | 'library' | 'updates' | 'security' | 'privacy' | '404';
  noindex?: boolean;
}

const {
  title,
  titleEn,
  description,
  descriptionEn,
  page = 'home',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const siteName = 'SagaSmithAI';
const fullTitle = `${title} · ${siteName}`;
const navigation = [
  { id: 'start', href: '/start', zh: '开始使用', en: 'Get started' },
  { id: 'developers', href: '/developers', zh: '开发者', en: 'Developers' },
  { id: 'library', href: '/library', zh: '内容库', en: 'Library' },
  { id: 'updates', href: '/updates', zh: '进展', en: 'Updates' },
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: siteName,
    url: Astro.site?.toString(),
    logo: new URL('/logo-mark.png', Astro.site).toString(),
    sameAs: ['https://github.com/SagaSmithAI'],
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteName,
    alternateName: 'SagaSmith',
    url: Astro.site?.toString(),
    inLanguage: ['zh-CN', 'en'],
  },
];
---
<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SagaSmithAI — Worlds that remember" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="SagaSmithAI — Worlds that remember" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{fullTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('sagasmith-language');
        if (saved === 'en') {
          document.documentElement.dataset.lang = 'en';
          document.documentElement.lang = 'en';
        }
      } catch {}
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#main-content">
      <span class="zh">跳到主要内容</span><span class="en">Skip to content</span>
    </a>
    <div class="ambient-grid" aria-hidden="true"></div>

    <header class="topbar">
      <a class="brand" href="/" aria-label="SagaSmithAI home">
        <img src="/favicon.svg" width="34" height="34" alt="" />
        <span>SagaSmith</span>
        <small>AI</small>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={page === item.id ? 'page' : undefined}>
            <span class="zh">{item.zh}</span><span class="en">{item.en}</span>
          </a>
        ))}
      </nav>

      <div class="header-actions">
        <a class="github-link" href="https://github.com/SagaSmithAI" target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <button class="language" type="button" aria-label="Switch to English">
          <span data-lang-label>EN</span>
        </button>
        <details class="mobile-menu">
          <summary><span class="zh">导航</span><span class="en">Menu</span></summary>
          <nav aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a href={item.href} aria-current={page === item.id ? 'page' : undefined}>
                <span class="zh">{item.zh}</span><span class="en">{item.en}</span>
              </a>
            ))}
            <a href="https://github.com/SagaSmithAI" target="_blank" rel="noreferrer">GitHub ↗</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main-content" tabindex="-1"><slot /></main>

    <footer class="footer shell">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="SagaSmithAI home">
          <img src="/favicon.svg" width="34" height="34" alt="" loading="lazy" />
          <span>SagaSmith</span><small>AI</small>
        </a>
        <p>
          <span class="zh">让世界记得，让规则落槌。</span>
          <span class="en">Worlds remember. Rules settle.</span>
        </p>
      </div>
      <div class="footer-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="zh">公开开发 · Active Alpha</span><span class="en">Public development · Active Alpha</span>
      </div>
      <nav aria-label="Footer navigation">
        <a href="/privacy"><span class="zh">隐私</span><span class="en">Privacy</span></a>
        <a href="/security"><span class="zh">安全</span><span class="en">Security</span></a>
        <a href="https://github.com/SagaSmithAI/.github/blob/main/CONTRIBUTING.md" target="_blank" rel="noreferrer">
          <span class="zh">贡献</span><span class="en">Contribute</span>
        </a>
        <a href="https://github.com/SagaSmithAI/SagaSmithAI.github.io" target="_blank" rel="noreferrer">
          <span class="zh">本站源码</span><span class="en">Site source</span>
        </a>
      </nav>
    </footer>

    <script is:inline define:vars={{ title, titleEn, description, descriptionEn }}>
      const root = document.documentElement;
      const button = document.querySelector('.language');
      const label = document.querySelector('[data-lang-label]');

      const setLanguage = (lang) => {
        root.dataset.lang = lang;
        root.lang = lang === 'zh' ? 'zh-CN' : 'en';
        document.title = `${lang === 'zh' ? title : titleEn} · SagaSmithAI`;
        document.querySelector('meta[name="description"]')?.setAttribute('content', lang === 'zh' ? description : descriptionEn);
        if (label) label.textContent = lang === 'zh' ? 'EN' : '中';
        if (button) button.setAttribute('aria-label', lang === 'zh' ? 'Switch to English' : '切换到中文');
        try { localStorage.setItem('sagasmith-language', lang); } catch {}
      };

      setLanguage(root.dataset.lang === 'en' ? 'en' : 'zh');
      button?.addEventListener('click', () => setLanguage(root.dataset.lang === 'zh' ? 'en' : 'zh'));

      const mobileMenu = document.querySelector('.mobile-menu');
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') mobileMenu?.removeAttribute('open');
      });

    </script>
  </body>
</html>
